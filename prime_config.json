{
  "model": "FAC",
  "version": "PRIME_1_W_STD",
  "eras": "next",
  "ampere_version": "0_0",
  "data_version": "prime_1_0",
  "random_seed": 42,
  "input_params": [
    "Vx",
    "Vx_std",
    "BX_GSE",
    "BX_GSE_std",
    "BY_GSM",
    "BY_GSM_std",
    "BZ_GSM",
    "BZ_GSM_std",
    "proton_density",
    "proton_density_std",
    "sin_month",
    "cos_month",
    "F107"
  ],
  "bk_input_params": ["Bz", "By", "Bx", "Vx", "Np", "month_sine", "month_cosine"],
  "ampere_delay": 0,
  "output_size": [50, 26],
  "shuffling_split_data": true,
  "extract_storms": false,
  "use_disturbed_time_list": false,
  "length": 240,
  "patience": 120,
  "lead": 1440,
  "recovery": 2880,
  "substorm_lead": 240,
  "substorm_recovery": 360,
  "storm_lead": 1440,
  "storm_recovery": 2880,
  "storm_extract_param": "SME",
  "storm_extract_limit": 600,

  "specific_test_storms": [],
  "time_history": 60,
  "filters": 128,
  "learning_rate": 1e-6,
  "epochs": 200,
  "loss": "mse",
  "early_stop_patience": 250,
  "batch_size": 64,

  "ampere_path": "~/Volumes/TARDIS/AIMFAHR/ampere_data/",
  "omni_path": "~/Volumes/TARDIS/AIMFAHR/omni_data/",
  "prepared_data_path": "~/Volumes/TARDIS/AIMFAHR/prepared_data/",

  "model_dir": "models/",
  "plot_dir": "plots/",
  "results_dir": "results/",
  "outputs_dir": "outputs/",

  "data_dir": "data/",
  "sw_data": "prep/prime_predictions.feather",
  "indicies_data": "prep/supermag_indicies.feather",
  "F107_data": "prep/fluxtable.txt",

  "model_config": {
    "in_channels": 1,
    "out_channels": 2,
    "base_channels": 64,
    "depth": 2,
    "num_res_blocks": 2,
    "layers_per_block": 2,
    "channel_mult": 2.0,
    "cbam_reduction": 8,
    "dropout_rate": 0.3,
    "dropout_depth": 0,
    "debug": false,
    "use_cbam": true,
    "use_attention_gates": true
  }
